{
  "manifest_version": 3,
  "name": "fiverr",
  "version": "1.0.0",
  "description": "Hide your available balance on Fiverr for privacy.",
  "content_scripts": [
    {
      "matches": [
        "https://www.fiverr.com/*",
        "https://fiverr.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "fiverr"
  },
  "permissions": [
    "storage",
    "activeTab"
  ]
}
