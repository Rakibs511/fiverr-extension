{
  "manifest_version": 3,
  "name": "fiverr",
  "version": "1.1.0",
  "description": "Hide balance, dark mode, and auto-refresh for Fiverr.",
  "content_scripts": [
    {
      "matches": [
        "https://www.fiverr.com/*",
        "https://fiverr.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "fiverr"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "alarms"
  ]
}
